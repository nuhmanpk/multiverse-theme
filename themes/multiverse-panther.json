      ],
      "settings": {
        "foreground": "#b07cff"
      }
    },
    {
      "name": "Rust lifetime",
      "scope": [
        "entity.name.type.lifetime",
        "storage.modifier.lifetime"
      ],
      "settings": {
        "foreground": "#b07cff",
        "fontStyle": "italic"
      }
    },
    {
