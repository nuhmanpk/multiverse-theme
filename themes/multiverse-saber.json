    {
      "name": "Rust macro",
      "scope": [
        "entity.name.function.macro",
        "support.function.macro"
      ],
      "settings": {
        "foreground": "#ffb84d"
      }
    },
    {
      "name": "Go package",
      "scope": [
        "entity.name.package.go",
        "entity.name.import.go"
      ],
      "settings": {
        "foreground": "#b38cff"
      }
    },
    {
      "name": "SQL keyword",
      "scope": [
        "keyword.other.DML.sql",
        "keyword.other.DDL.create.II.sql",
        "keyword.other.sql"
      ],
      "settings": {
        "foreground": "#ff4d4d"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff6b6b",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#f5b94d",
        "fontStyle": "strikethrough"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#b38cff",
    "class": "#b38cff",
    "class.defaultLibrary": "#b38cff",
    "interface": {
      "foreground": "#b38cff",
      "italic": true
    },
    "enum": "#b38cff",
    "enumMember": "#ff8080",
    "struct": "#b38cff",
    "typeParameter": {
      "foreground": "#b38cff",
      "italic": true
    },
    "type": "#b38cff",
    "function": "#4fa3ff",
    "method": "#4fa3ff",
    "function.defaultLibrary": "#4fa3ff",
    "macro": "#ffb84d",
    "decorator": "#ffb84d",
    "parameter": "#c8cde0",
    "variable": "#e6e8ef",
    "variable.readonly": "#ff8080",
    "variable.defaultLibrary": "#ff8080",
    "property": "#8bbff9",
    "property.readonly": "#8bbff9",
    "keyword": "#ff4d4d",
    "selfKeyword": {
      "foreground": "#ff4d4d",
      "italic": true
    },
    "string": "#7dff8a",
    "number": "#ffb84d",
    "regexp": "#b38cff",
