  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#6a6a78",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc tag",
      "scope": [
        "comment storage.type",
        "comment keyword.other",
        "comment.block.documentation entity.name.type"
      ],
      "settings": {
        "foreground": "#f2f2f5",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.other.using",
        "keyword.other.import"
      ],
      "settings": {
        "foreground": "#f2f2f5"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value",
        "storage.type.function.arrow"
      ],
      "settings": {
        "foreground": "#fafafc"
      }
    },
    {
      "name": "Word operators",
      "scope": [
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.operator.word"
      ],
      "settings": {
        "foreground": "#f2f2f5"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function",
        "entity.name.method"
      ],
      "settings": {
        "foreground": "#8be36b"
      }
    },
    {
      "name": "Type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.primitive",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#9dd6ff"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.template"
      ],
      "settings": {
        "foreground": "#b8b8c8"
      }
    },
    {
      "name": "Template expression",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#f2f2f5"
      }
    },
    {
      "name": "Escape",
      "scope": [
        "constant.character.escape",
        "constant.character.format.placeholder",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#f2f2f5"
      }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp",
        "constant.other.character-class.regexp"
      ],
      "settings": {
        "foreground": "#9dd6ff"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#ff6b8a"
      }
    },
    {
      "name": "Constant",
      "scope": [
        "constant.language",
        "support.constant",
        "variable.other.constant",
        "constant.other",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#ff4d6d"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#f2f2f5"
      }
    },
    {
      "name": "Language variable",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#f2f2f5",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter",
        "meta.parameter variable"
      ],
      "settings": {
        "foreground": "#cfcfdc"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "entity.name.field"
      ],
      "settings": {
        "foreground": "#b4e9a2"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#a5a5a8"
      }
    },
    {
      "name": "Decorator",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "meta.attribute.rust",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#ff6b8a"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#f2f2f5"
      }
    },
    {
      "name": "Component tag",
      "scope": [
        "support.class.component.tsx",
        "support.class.component.jsx",
        "entity.name.tag.custom"
      ],
      "settings": {
        "foreground": "#9dd6ff"
      }
    },
    {
      "name": "Attribute",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html"
      ],
      "settings": {
        "foreground": "#cfcfdc"
      }
    },
    {
      "name": "CSS selector",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.tag.css"
      ],
      "settings": {
        "foreground": "#f2f2f5"
      }
    },
    {
      "name": "CSS property",
      "scope": [
        "support.type.property-name.css",
        "support.type.vendored.property-name",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#b4e9a2"
      }
    },
    {
      "name": "CSS value",
      "scope": [
        "support.constant.property-value",
        "support.constant.color",
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#ff6b8a"
      }
    },
    {
      "name": "JSON key 1",
      "scope": [
        "source.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#8be36b"
      }
    },
    {
      "name": "JSON key 2",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#f2f2f5"
      }
    },
    {
      "name": "JSON key 3",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#9dd6ff"
      }
    },
    {
      "name": "YAML key",
      "scope": [
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#8be36b"
      }
    },
    {
      "name": "Markdown heading",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "markup.heading punctuation.definition.heading"
      ],
      "settings": {
        "foreground": "#8be36b",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#ff6b8a",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#f2f2f5",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown strike",
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "foreground": "#a5a5a8",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#b8b8c8"
      }
    },
    {
      "name": "Markdown link",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "meta.link"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#a5a5a8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown list",
      "scope": [
        "punctuation.definition.list.begin.markdown",
        "beginning.punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#f2f2f5"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#b8b8c8"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file"
      ],
      "settings": {
        "foreground": "#ff6b6b"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "name": "Diff range",
      "scope": [
        "meta.diff.range",
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#f2f2f5"
      }
    },
    {
      "name": "Shell variable",
      "scope": [
        "variable.other.normal.shell",
        "punctuation.definition.variable.shell"
      ],
      "settings": {
        "foreground": "#cfcfdc"
      }
    },
    {
      "name": "Python self/cls",
      "scope": [
        "variable.parameter.function.language.special.self.python",
        "variable.parameter.function.language.special.cls.python"
      ],
      "settings": {
        "foreground": "#f2f2f5",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Python fstring braces",
      "scope": [
        "constant.character.format.placeholder.other.python",
        "meta.fstring.python punctuation"
      ],
      "settings": {
        "foreground": "#f2f2f5"
      }
    },
    {
      "name": "Rust lifetime",
      "scope": [
        "entity.name.type.lifetime",
        "storage.modifier.lifetime"
      ],
      "settings": {
        "foreground": "#f2f2f5",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Rust macro",
      "scope": [
        "entity.name.function.macro",
        "support.function.macro"
      ],
      "settings": {
        "foreground": "#ff6b8a"
      }
    },
    {
      "name": "Go package",
      "scope": [
        "entity.name.package.go",
        "entity.name.import.go"
      ],
      "settings": {
        "foreground": "#9dd6ff"
      }
    },
    {
      "name": "SQL keyword",
      "scope": [
        "keyword.other.DML.sql",
        "keyword.other.DDL.create.II.sql",
        "keyword.other.sql"
      ],
      "settings": {
        "foreground": "#f2f2f5"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff6b6b",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#f5b94d",
        "fontStyle": "strikethrough"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#9dd6ff",
    "class": "#9dd6ff",
    "class.defaultLibrary": "#9dd6ff",
    "interface": {
      "foreground": "#9dd6ff",
      "italic": true
    },
    "enum": "#9dd6ff",
    "enumMember": "#ff4d6d",
    "struct": "#9dd6ff",
    "typeParameter": {
      "foreground": "#9dd6ff",
      "italic": true
    },
    "type": "#9dd6ff",
    "function": "#8be36b",
    "method": "#8be36b",
    "function.defaultLibrary": "#8be36b",
    "macro": "#ff6b8a",
    "decorator": "#ff6b8a",
    "parameter": "#cfcfdc",
    "variable": "#f2f2f5",
    "variable.readonly": "#ff4d6d",
    "variable.defaultLibrary": "#ff4d6d",
    "property": "#b4e9a2",
    "property.readonly": "#b4e9a2",
    "keyword": "#f2f2f5",
    "selfKeyword": {
      "foreground": "#f2f2f5",
      "italic": true
    },
    "string": "#b8b8c8",
    "number": "#ff6b8a",
    "regexp": "#9dd6ff",
    "operator": "#fafafc",
    "comment": {
      "foreground": "#6a6a78",
      "italic": true
    },
    "lifetime": {
