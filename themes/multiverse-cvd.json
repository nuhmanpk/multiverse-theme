        "support.function.macro"
      ],
      "settings": {
        "foreground": "#ff7a1a"
      }
    },
    {
      "name": "Go package",
      "scope": [
        "entity.name.package.go",
        "entity.name.import.go"
      ],
      "settings": {
        "foreground": "#e2e4e9"
      }
    },
    {
      "name": "SQL keyword",
      "scope": [
        "keyword.other.DML.sql",
        "keyword.other.DDL.create.II.sql",
        "keyword.other.sql"
      ],
      "settings": {
        "foreground": "#4ea3ff"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff7a1a",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#ffd76a",
        "fontStyle": "strikethrough"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#e2e4e9",
    "class": "#e2e4e9",
    "class.defaultLibrary": "#e2e4e9",
    "interface": {
      "foreground": "#e2e4e9",
      "italic": true
    },
    "enum": "#e2e4e9",
    "enumMember": "#ffd76a",
    "struct": "#e2e4e9",
    "typeParameter": {
      "foreground": "#e2e4e9",
      "italic": true
    },
    "type": "#e2e4e9",
    "function": "#ffb000",
    "method": "#ffb000",
    "function.defaultLibrary": "#ffb000",
    "macro": "#ff7a1a",
    "decorator": "#ff7a1a",
    "parameter": "#c7c9d1",
    "variable": "#e2e4e9",
    "variable.readonly": "#ffd76a",
    "variable.defaultLibrary": "#ffd76a",
    "property": "#b9c6e0",
    "property.readonly": "#b9c6e0",
    "keyword": "#4ea3ff",
    "selfKeyword": {
      "foreground": "#4ea3ff",
      "italic": true
    },
    "string": "#9ab7ff",
    "number": "#ff7a1a",
