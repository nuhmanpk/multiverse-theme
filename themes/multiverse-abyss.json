      "name": "Go package",
      "scope": [
        "entity.name.package.go",
        "entity.name.import.go"
      ],
      "settings": {
        "foreground": "#8aa8ff"
      }
    },
    {
      "name": "SQL keyword",
      "scope": [
        "keyword.other.DML.sql",
        "keyword.other.DDL.create.II.sql",
        "keyword.other.sql"
      ],
      "settings": {
        "foreground": "#00f0ff"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff6b6b",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#f5b94d",
        "fontStyle": "strikethrough"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#8aa8ff",
    "class": "#8aa8ff",
    "class.defaultLibrary": "#8aa8ff",
    "interface": {
      "foreground": "#8aa8ff",
      "italic": true
    },
    "enum": "#8aa8ff",
    "enumMember": "#ff9a6b",
    "struct": "#8aa8ff",
    "typeParameter": {
      "foreground": "#8aa8ff",
      "italic": true
    },
    "type": "#8aa8ff",
    "function": "#7affc4",
    "method": "#7affc4",
    "function.defaultLibrary": "#7affc4",
    "macro": "#ffe066",
    "decorator": "#ffe066",
    "parameter": "#a8c8d8",
    "variable": "#cfe8f5",
    "variable.readonly": "#ff9a6b",
    "variable.defaultLibrary": "#ff9a6b",
    "property": "#9cf6d8",
    "property.readonly": "#9cf6d8",
    "keyword": "#00f0ff",
    "selfKeyword": {
      "foreground": "#00f0ff",
      "italic": true
    },
    "string": "#ff7ae0",
    "number": "#ffe066",
    "regexp": "#8aa8ff",
    "operator": "#48edfc",
    "comment": {
      "foreground": "#3f6a80",
      "italic": true
    },
    "lifetime": {
      "foreground": "#00f0ff",
      "italic": true
    },
    "*.deprecated": {
      "strikethrough": true
    }
  }
}
