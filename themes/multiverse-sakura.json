  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#8a7280",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc tag",
      "scope": [
        "comment storage.type",
        "comment keyword.other",
        "comment.block.documentation entity.name.type"
      ],
      "settings": {
        "foreground": "#b0246a",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.other.using",
        "keyword.other.import"
      ],
      "settings": {
        "foreground": "#b0246a"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value",
        "storage.type.function.arrow"
      ],
      "settings": {
        "foreground": "#9f3058"
      }
    },
    {
      "name": "Word operators",
      "scope": [
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.operator.word"
      ],
      "settings": {
        "foreground": "#b0246a"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function",
        "entity.name.method"
      ],
      "settings": {
        "foreground": "#4a5fc1"
      }
    },
    {
      "name": "Type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.primitive",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#7a4bbf"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.template"
      ],
      "settings": {
        "foreground": "#3f7a3a"
      }
    },
    {
      "name": "Template expression",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#b0246a"
      }
    },
    {
      "name": "Escape",
      "scope": [
        "constant.character.escape",
        "constant.character.format.placeholder",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#b0246a"
      }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp",
        "constant.other.character-class.regexp"
      ],
      "settings": {
        "foreground": "#7a4bbf"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#ad5128"
      }
    },
    {
      "name": "Constant",
      "scope": [
        "constant.language",
        "support.constant",
        "variable.other.constant",
        "constant.other",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#c02a3c"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#3a2a33"
      }
    },
    {
      "name": "Language variable",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#b0246a",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter",
        "meta.parameter variable"
      ],
      "settings": {
        "foreground": "#8a5a2b"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "entity.name.field"
      ],
      "settings": {
        "foreground": "#444a88"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#76696f"
      }
    },
    {
      "name": "Decorator",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "meta.attribute.rust",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#ad5128"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#b0246a"
      }
    },
    {
      "name": "Component tag",
      "scope": [
        "support.class.component.tsx",
        "support.class.component.jsx",
        "entity.name.tag.custom"
      ],
      "settings": {
        "foreground": "#7a4bbf"
      }
    },
    {
      "name": "Attribute",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html"
      ],
      "settings": {
        "foreground": "#8a5a2b"
      }
    },
    {
      "name": "CSS selector",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.tag.css"
      ],
      "settings": {
        "foreground": "#b0246a"
      }
    },
    {
      "name": "CSS property",
      "scope": [
        "support.type.property-name.css",
        "support.type.vendored.property-name",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#444a88"
      }
    },
    {
      "name": "CSS value",
      "scope": [
        "support.constant.property-value",
        "support.constant.color",
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#ad5128"
      }
    },
    {
      "name": "JSON key 1",
      "scope": [
        "source.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#4a5fc1"
      }
    },
    {
      "name": "JSON key 2",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#b0246a"
      }
    },
    {
      "name": "JSON key 3",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#7a4bbf"
      }
    },
    {
      "name": "YAML key",
      "scope": [
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#4a5fc1"
      }
    },
    {
      "name": "Markdown heading",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "markup.heading punctuation.definition.heading"
      ],
      "settings": {
        "foreground": "#4a5fc1",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#ad5128",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#b0246a",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown strike",
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "foreground": "#76696f",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#3f7a3a"
      }
    },
    {
      "name": "Markdown link",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "meta.link"
      ],
      "settings": {
        "foreground": "#d6336c",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#76696f",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown list",
      "scope": [
        "punctuation.definition.list.begin.markdown",
        "beginning.punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#b0246a"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#3f7a3a"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file"
      ],
      "settings": {
        "foreground": "#c62828"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#d6336c"
      }
    },
    {
      "name": "Diff range",
      "scope": [
        "meta.diff.range",
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#b0246a"
      }
    },
    {
      "name": "Shell variable",
      "scope": [
        "variable.other.normal.shell",
        "punctuation.definition.variable.shell"
      ],
      "settings": {
        "foreground": "#8a5a2b"
      }
    },
    {
      "name": "Python self/cls",
