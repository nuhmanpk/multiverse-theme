      "foreground": "#ffd23f",
      "italic": true
    },
    "type": "#ffd23f",
    "function": "#5ccfff",
    "method": "#5ccfff",
    "function.defaultLibrary": "#5ccfff",
    "macro": "#ffb347",
    "decorator": "#ffb347",
    "parameter": "#ffffff",
    "variable": "#ffffff",
    "variable.readonly": "#ff7070",
    "variable.defaultLibrary": "#ff7070",
    "property": "#9de2ff",
