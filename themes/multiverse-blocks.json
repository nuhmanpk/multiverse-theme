    {
      "name": "Go package",
      "scope": [
        "entity.name.package.go",
        "entity.name.import.go"
      ],
      "settings": {
        "foreground": "#c9a06a"
      }
    },
    {
      "name": "SQL keyword",
      "scope": [
        "keyword.other.DML.sql",
        "keyword.other.DDL.create.II.sql",
        "keyword.other.sql"
      ],
      "settings": {
        "foreground": "#5fd35f"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff6b6b",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#f5b94d",
        "fontStyle": "strikethrough"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#c9a06a",
    "class": "#c9a06a",
    "class.defaultLibrary": "#c9a06a",
    "interface": {
      "foreground": "#c9a06a",
      "italic": true
    },
    "enum": "#c9a06a",
    "enumMember": "#ff7a6a",
    "struct": "#c9a06a",
    "typeParameter": {
      "foreground": "#c9a06a",
      "italic": true
    },
    "type": "#c9a06a",
    "function": "#5ee1e6",
    "method": "#5ee1e6",
    "function.defaultLibrary": "#5ee1e6",
    "macro": "#ff5a4a",
    "decorator": "#ff5a4a",
    "parameter": "#d6ccb8",
    "variable": "#ede6da",
    "variable.readonly": "#ff7a6a",
    "variable.defaultLibrary": "#ff7a6a",
    "property": "#97e3e1",
    "property.readonly": "#97e3e1",
    "keyword": "#5fd35f",
    "selfKeyword": {
      "foreground": "#5fd35f",
      "italic": true
    },
    "string": "#e0c48a",
    "number": "#ff5a4a",
    "regexp": "#c9a06a",
    "operator": "#91da8a",
    "comment": {
      "foreground": "#827d75",
      "italic": true
    },
    "lifetime": {
      "foreground": "#5fd35f",
      "italic": true
    },
    "*.deprecated": {
      "strikethrough": true
    }
  }
}
