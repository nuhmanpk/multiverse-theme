        "foreground": "#ffc8e8"
      }
    },
    {
      "name": "Go package",
      "scope": [
        "entity.name.package.go",
        "entity.name.import.go"
      ],
      "settings": {
        "foreground": "#7ab8ff"
      }
    },
    {
      "name": "SQL keyword",
      "scope": [
        "keyword.other.DML.sql",
        "keyword.other.DDL.create.II.sql",
        "keyword.other.sql"
      ],
      "settings": {
        "foreground": "#9be7ff"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff6b6b",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#f5b94d",
        "fontStyle": "strikethrough"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#7ab8ff",
    "class": "#7ab8ff",
    "class.defaultLibrary": "#7ab8ff",
    "interface": {
      "foreground": "#7ab8ff",
      "italic": true
    },
    "enum": "#7ab8ff",
    "enumMember": "#ffe08a",
    "struct": "#7ab8ff",
    "typeParameter": {
      "foreground": "#7ab8ff",
      "italic": true
    },
    "type": "#7ab8ff",
    "function": "#c8b6ff",
    "method": "#c8b6ff",
    "function.defaultLibrary": "#c8b6ff",
    "macro": "#ffc8e8",
    "decorator": "#ffc8e8",
    "parameter": "#c0d4e4",
    "variable": "#e8f6ff",
    "variable.readonly": "#ffe08a",
    "variable.defaultLibrary": "#ffe08a",
    "property": "#d5d0ff",
    "property.readonly": "#d5d0ff",
    "keyword": "#9be7ff",
    "selfKeyword": {
      "foreground": "#9be7ff",
      "italic": true
    },
    "string": "#b8ffd8",
    "number": "#ffc8e8",
    "regexp": "#7ab8ff",
