        "support.function.macro"
      ],
      "settings": {
        "foreground": "#ff8f5c"
      }
    },
    {
      "name": "Go package",
      "scope": [
        "entity.name.package.go",
        "entity.name.import.go"
      ],
      "settings": {
        "foreground": "#8ad0ff"
      }
    },
    {
      "name": "SQL keyword",
      "scope": [
        "keyword.other.DML.sql",
        "keyword.other.DDL.create.II.sql",
        "keyword.other.sql"
      ],
      "settings": {
        "foreground": "#ffd23f"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff6b6b",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#f5b94d",
        "fontStyle": "strikethrough"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#8ad0ff",
    "class": "#8ad0ff",
    "class.defaultLibrary": "#8ad0ff",
    "interface": {
      "foreground": "#8ad0ff",
      "italic": true
    },
    "enum": "#8ad0ff",
    "enumMember": "#ff6b7a",
    "struct": "#8ad0ff",
    "typeParameter": {
      "foreground": "#8ad0ff",
      "italic": true
    },
    "type": "#8ad0ff",
    "function": "#5fa8ff",
    "method": "#5fa8ff",
    "function.defaultLibrary": "#5fa8ff",
    "macro": "#ff8f5c",
    "decorator": "#ff8f5c",
    "parameter": "#cfd9f0",
    "variable": "#e5ebf8",
    "variable.readonly": "#ff6b7a",
    "variable.defaultLibrary": "#ff6b7a",
    "property": "#95c3fc",
    "property.readonly": "#95c3fc",
    "keyword": "#ffd23f",
    "selfKeyword": {
      "foreground": "#ffd23f",
      "italic": true
    },
    "string": "#b9e38a",
    "number": "#ff8f5c",
    "regexp": "#8ad0ff",
    "operator": "#f6db80",
    "comment": {
      "foreground": "#798094",
      "italic": true
    },
    "lifetime": {
      "foreground": "#ffd23f",
      "italic": true
    },
    "*.deprecated": {
      "strikethrough": true
    }
  }
}
