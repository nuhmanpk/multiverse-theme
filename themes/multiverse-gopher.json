      }
    },
    {
      "name": "Go package",
      "scope": [
        "entity.name.package.go",
        "entity.name.import.go"
      ],
      "settings": {
        "foreground": "#5dc9e2"
      }
    },
    {
      "name": "SQL keyword",
      "scope": [
        "keyword.other.DML.sql",
        "keyword.other.DDL.create.II.sql",
        "keyword.other.sql"
      ],
      "settings": {
        "foreground": "#00add8"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff6b6b",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#f5b94d",
        "fontStyle": "strikethrough"
      }
    }
  ],
  "semanticTokenColors": {
