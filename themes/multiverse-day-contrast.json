    {
      "name": "Go package",
      "scope": [
        "entity.name.package.go",
        "entity.name.import.go"
      ],
      "settings": {
        "foreground": "#04574f"
      }
    },
    {
      "name": "SQL keyword",
      "scope": [
        "keyword.other.DML.sql",
        "keyword.other.DDL.create.II.sql",
        "keyword.other.sql"
      ],
      "settings": {
        "foreground": "#5a1fa8"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#b00020",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#7a4f00",
        "fontStyle": "strikethrough"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#04574f",
    "class": "#04574f",
    "class.defaultLibrary": "#04574f",
    "interface": {
      "foreground": "#04574f",
      "italic": true
    },
    "enum": "#04574f",
    "enumMember": "#9e1620",
    "struct": "#04574f",
    "typeParameter": {
      "foreground": "#04574f",
      "italic": true
    },
    "type": "#04574f",
    "function": "#0b4a94",
    "method": "#0b4a94",
    "function.defaultLibrary": "#0b4a94",
    "macro": "#8a3b00",
    "decorator": "#8a3b00",
    "parameter": "#6b4200",
    "variable": "#000000",
    "variable.readonly": "#9e1620",
    "variable.defaultLibrary": "#9e1620",
    "property": "#173f7a",
    "property.readonly": "#173f7a",
    "keyword": "#5a1fa8",
    "selfKeyword": {
      "foreground": "#5a1fa8",
      "italic": true
    },
    "string": "#245c0e",
    "number": "#8a3b00",
    "regexp": "#0a5a42",
    "operator": "#064f66",
    "comment": {
      "foreground": "#4a4f58",
      "italic": true
    },
    "lifetime": {
      "foreground": "#8c1563",
      "italic": true
    },
    "*.deprecated": {
      "strikethrough": true
    }
  }
}
