  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#aab4ff",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc tag",
      "scope": [
        "comment storage.type",
        "comment keyword.other",
        "comment.block.documentation entity.name.type"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.other.using",
        "keyword.other.import"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value",
        "storage.type.function.arrow"
      ],
      "settings": {
        "foreground": "#f7f788"
      }
    },
    {
      "name": "Word operators",
      "scope": [
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.operator.word"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function",
        "entity.name.method"
      ],
      "settings": {
        "foreground": "#ffff55"
      }
    },
    {
      "name": "Type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.primitive",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.template"
      ],
      "settings": {
        "foreground": "#55ffff"
      }
    },
    {
      "name": "Template expression",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "name": "Escape",
      "scope": [
        "constant.character.escape",
        "constant.character.format.placeholder",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp",
        "constant.other.character-class.regexp"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#55ff55"
      }
    },
    {
      "name": "Constant",
      "scope": [
        "constant.language",
        "support.constant",
        "variable.other.constant",
        "constant.other",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#ff8fff"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#e8e8e8"
      }
    },
    {
      "name": "Language variable",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter",
        "meta.parameter variable"
      ],
      "settings": {
        "foreground": "#e8e8e8"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "entity.name.field"
      ],
      "settings": {
        "foreground": "#f6f690"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#9fa4ca"
      }
    },
    {
      "name": "Decorator",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "meta.attribute.rust",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#55ff55"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#ffff55"
      }
    },
    {
      "name": "Component tag",
      "scope": [
        "support.class.component.tsx",
        "support.class.component.jsx",
        "entity.name.tag.custom"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "name": "Attribute",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html"
      ],
      "settings": {
        "foreground": "#e8e8e8"
      }
    },
    {
      "name": "CSS selector",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.tag.css"
      ],
      "settings": {
        "foreground": "#ffff55"
      }
    },
    {
      "name": "CSS property",
      "scope": [
        "support.type.property-name.css",
        "support.type.vendored.property-name",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#f6f690"
      }
    },
    {
      "name": "CSS value",
      "scope": [
        "support.constant.property-value",
        "support.constant.color",
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#55ff55"
      }
    },
    {
      "name": "JSON key 1",
      "scope": [
        "source.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#ffff55"
      }
    },
    {
      "name": "JSON key 2",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "name": "JSON key 3",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "name": "YAML key",
      "scope": [
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#ffff55"
      }
    },
    {
      "name": "Markdown heading",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "markup.heading punctuation.definition.heading"
      ],
      "settings": {
        "foreground": "#ffff55",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#55ff55",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown strike",
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "foreground": "#9fa4ca",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#55ffff"
      }
    },
    {
      "name": "Markdown link",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "meta.link"
      ],
      "settings": {
        "foreground": "#ffff55",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#9fa4ca",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown list",
      "scope": [
        "punctuation.definition.list.begin.markdown",
        "beginning.punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#ffff55"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#55ffff"
      }
    },
    {
      "name": "Diff deleted",
