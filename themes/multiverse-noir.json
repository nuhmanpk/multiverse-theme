        "support.function.macro"
      ],
      "settings": {
        "foreground": "#ff9a7a"
      }
    },
    {
      "name": "Go package",
      "scope": [
        "entity.name.package.go",
        "entity.name.import.go"
      ],
      "settings": {
        "foreground": "#d8a0ff"
      }
    },
    {
      "name": "SQL keyword",
      "scope": [
        "keyword.other.DML.sql",
        "keyword.other.DDL.create.II.sql",
        "keyword.other.sql"
      ],
      "settings": {
        "foreground": "#ff5a36"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff6b6b",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#f5b94d",
        "fontStyle": "strikethrough"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#d8a0ff",
    "class": "#d8a0ff",
    "class.defaultLibrary": "#d8a0ff",
    "interface": {
      "foreground": "#d8a0ff",
      "italic": true
    },
    "enum": "#d8a0ff",
    "enumMember": "#7ad0e0",
    "struct": "#d8a0ff",
    "typeParameter": {
      "foreground": "#d8a0ff",
      "italic": true
    },
    "type": "#d8a0ff",
    "function": "#f2c46b",
    "method": "#f2c46b",
    "function.defaultLibrary": "#f2c46b",
    "macro": "#ff9a7a",
    "decorator": "#ff9a7a",
    "parameter": "#d8c0a8",
    "variable": "#f0dfcc",
    "variable.readonly": "#7ad0e0",
    "variable.defaultLibrary": "#7ad0e0",
    "property": "#f1cf92",
    "property.readonly": "#f1cf92",
    "keyword": "#ff5a36",
    "selfKeyword": {
      "foreground": "#ff5a36",
      "italic": true
    },
    "string": "#9fc87a",
    "number": "#ff9a7a",
    "regexp": "#d8a0ff",
    "operator": "#fa896b",
    "comment": {
      "foreground": "#85796e",
      "italic": true
    },
    "lifetime": {
