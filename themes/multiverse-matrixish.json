    {
      "name": "Rust lifetime",
      "scope": [
        "entity.name.type.lifetime",
        "storage.modifier.lifetime"
      ],
      "settings": {
        "foreground": "#39ff6a",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Rust macro",
      "scope": [
        "entity.name.function.macro",
        "support.function.macro"
      ],
      "settings": {
        "foreground": "#7affd4"
      }
    },
    {
      "name": "Go package",
      "scope": [
        "entity.name.package.go",
        "entity.name.import.go"
      ],
      "settings": {
        "foreground": "#5ce6a0"
      }
    },
    {
      "name": "SQL keyword",
      "scope": [
        "keyword.other.DML.sql",
        "keyword.other.DDL.create.II.sql",
        "keyword.other.sql"
      ],
      "settings": {
        "foreground": "#39ff6a"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff6b6b",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#f5b94d",
        "fontStyle": "strikethrough"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#5ce6a0",
