    {
      "name": "Go package",
      "scope": [
        "entity.name.package.go",
        "entity.name.import.go"
      ],
      "settings": {
        "foreground": "#1d2129"
      }
    },
    {
      "name": "SQL keyword",
      "scope": [
        "keyword.other.DML.sql",
        "keyword.other.DDL.create.II.sql",
        "keyword.other.sql"
      ],
      "settings": {
        "foreground": "#00337a"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ba4700",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#7a5a00",
        "fontStyle": "strikethrough"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#1d2129",
    "class": "#1d2129",
    "class.defaultLibrary": "#1d2129",
    "interface": {
      "foreground": "#1d2129",
      "italic": true
    },
    "enum": "#1d2129",
    "enumMember": "#7a5a00",
    "struct": "#1d2129",
    "typeParameter": {
      "foreground": "#1d2129",
      "italic": true
    },
    "type": "#1d2129",
    "function": "#a85400",
    "method": "#a85400",
    "function.defaultLibrary": "#a85400",
    "macro": "#5c4a00",
    "decorator": "#5c4a00",
    "parameter": "#3f4450",
    "variable": "#1d2129",
    "variable.readonly": "#7a5a00",
    "variable.defaultLibrary": "#7a5a00",
    "property": "#2f4a7a",
    "property.readonly": "#2f4a7a",
    "keyword": "#00337a",
    "selfKeyword": {
      "foreground": "#00337a",
      "italic": true
    },
    "string": "#296bc8",
    "number": "#5c4a00",
    "regexp": "#ba4700",
    "operator": "#4a5160",
    "comment": {
      "foreground": "#6a707c",
      "italic": true
    },
    "lifetime": {
      "foreground": "#7a5a00",
      "italic": true
    },
    "*.deprecated": {
      "strikethrough": true
    }
  }
}
