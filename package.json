    "commands": [
      {
        "command": "multiverse.pick",
        "title": "Pick a Universe (live preview)",
        "category": "Multiverse"
      },
      {
        "command": "multiverse.random",
        "title": "Random Universe",
        "category": "Multiverse"
      },
      {
        "command": "multiverse.next",
        "title": "Next Universe",
        "category": "Multiverse"
      },
      {
        "command": "multiverse.previous",
        "title": "Previous Universe",
        "category": "Multiverse"
      },
      {
        "command": "multiverse.daily",
        "title": "Today's Universe",
        "category": "Multiverse"
      },
      {
        "command": "multiverse.pickIcons",
        "title": "Pick Folder Icon Style (live preview)",
        "category": "Multiverse"
      }
    ],
    "keybindings": [
      {
        "command": "multiverse.pick",
        "key": "ctrl+alt+m",
        "mac": "ctrl+cmd+m"
      },
      {
        "command": "multiverse.random",
        "key": "ctrl+alt+r",
        "mac": "ctrl+cmd+r"
      }
    ],
    "configuration": {
      "title": "Multiverse",
      "properties": {
        "multiverse.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the current universe in the status bar (click to switch)."
        },
        "multiverse.dailyUniverse": {
          "type": "boolean",
          "default": false,
          "description": "Switch to a new universe each day on startup (same one all day)."
        },
        "multiverse.schedule": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "markdownDescription": "Switch by time of day. Keys are `HH:MM`, values are variant names. Example: `{ \"07:00\": \"Day\", \"18:00\": \"Lo-fi Study\", \"23:00\": \"Night Shift\" }`. Takes priority over `dailyUniverse`."
        },
        "multiverse.randomPool": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string",
            "enum": [
              "Core",
              "Accessibility",
              "Focus & Workflow",
              "Heroes & Villains",
              "Anime",
              "Cartoons",
              "Sci-fi & Games",
              "Retro",
              "Dev Culture",
              "Moods & Seasons",
              "Nature, Food & Myth",
              "Art & Design",
              "Neon & Electric",
              "Luxe & Cinematic"
            ]
          },
          "description": "Limit Random / Daily universe to these groups (empty = all)."
        },
        "multiverse.randomKinds": {
          "type": "array",
          "default": [
            "dark",
            "light"
          ],
          "items": {
            "type": "string",
            "enum": [
              "dark",
              "light"
            ]
          },
          "description": "Limit Random / Daily universe to dark and/or light variants."
        }
      }
    },
